<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>1701;1702;S3878</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\BigExcelCreator\BigExcelCreator.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Make analyzer available in this example project since it's not included by default -->
		<!-- Developers consuming the library through NuGet will have the analyzer included automatically, and this ItemGroup is not needed -->
		<ProjectReference
			Include="..\BigExcelCreator.Analyzers\BigExcelCreator.Analyzers.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
