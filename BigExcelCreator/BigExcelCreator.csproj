<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net35;net40;net46;net48;net8.0;net10.0</TargetFrameworks>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<Title>Create large Excel files with stylesheet Quickly using SAX</Title>
		<Description>Create Excel files using OpenXML SAX with styling.
This is specially useful when trying to write tens of thousands of rows.</Description>
		<Authors>Federico Seckel</Authors>
		<PackageTags>Excel;SAX;OpenXML;</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<EnableNETAnalyzers>True</EnableNETAnalyzers>
		<AnalysisLevel>latest-all</AnalysisLevel>
		<NBGV_SetVersion>false</NBGV_SetVersion>
		<NBGV_EmitThisAssemblyClass>false</NBGV_EmitThisAssemblyClass>
		<PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
		<Deterministic>True</Deterministic>
		<LangVersion>latest</LangVersion>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<PackageProjectUrl>https://fenase.github.io/projects/BigExcelCreator</PackageProjectUrl>
		<PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/../CHANGELOG.md").Replace("`r`n", "`n"))</PackageReleaseNotes>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<NoWarn>1701;1702;S3220</NoWarn>
		<WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
		<DebugType>embedded</DebugType>
		<CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TF_BUILD)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<Target Name="SetVersionFromCommitDate" DependsOnTargets="GetBuildVersion" AfterTargets="GetBuildVersion" BeforeTargets="GetAssemblyVersion;GenerateNuspec;_GetOutputItemsFromPack">
		<PropertyGroup>
			<!-- Fallback to 2000-01-01 UTC if built from a source archive without a .git directory -->
			<CommitTicks Condition="'$(GitCommitDateTicks)' != ''">$(GitCommitDateTicks)</CommitTicks>
			<CommitTicks Condition="'$(CommitTicks)' == ''">630822816000000000</CommitTicks>

			<CommitYear>$([System.DateTime]::new($(CommitTicks), System.DateTimeKind.Utc).ToString('yyyy'))</CommitYear>
			<CommitDayOfYear>$([System.DateTime]::new($(CommitTicks), System.DateTimeKind.Utc).DayOfYear)</CommitDayOfYear>
			<CommitHour>$([System.DateTime]::new($(CommitTicks), System.DateTimeKind.Utc).ToString('HH'))</CommitHour>

			<VersionPrefix Condition="'$(MajorMinorVersion)' != ''">$(MajorMinorVersion)</VersionPrefix>
			<VersionSuffix>$(CommitYear).$(CommitDayOfYear)$(CommitHour)</VersionSuffix>
			<Version>$(VersionPrefix).$(VersionSuffix)</Version>
			<PackageVersion>$(Version)</PackageVersion>
			<AssemblyVersion>$(Version)</AssemblyVersion>
			<FileVersion>$(Version)</FileVersion>
			<InformationalVersion Condition="'$(GitCommitIdShort)' != ''">$(Version)+$(GitCommitIdShort)</InformationalVersion>
			<InformationalVersion Condition="'$(GitCommitIdShort)' == ''">$(Version)</InformationalVersion>
		</PropertyGroup>
	</Target>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\CHANGELOG.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DocumentFormat.OpenXml" Version="[3.5.1,4)" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net40' Or '$(TargetFramework)' == 'net46' Or '$(TargetFramework)' == 'net48'">
		<Reference Include="System.ComponentModel.DataAnnotations" />
	</ItemGroup>

</Project>
